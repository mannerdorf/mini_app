# Crontab для API-VPS (api.haulz.ru / 72.56.36.185).
#
# После split: cache/cron job — только на отдельном cron-VPS.
# Используйте deploy/crontab.haulz-cron.example там.
#
# На API-VPS оставить watchdog TLS (nginx) + при необходимости локальные проверки.

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

* * * * * /opt/haulz/watchdog-api-tls.sh >/dev/null 2>&1
