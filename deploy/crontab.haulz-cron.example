# Только cron-VPS. Часовой пояс ОС должен быть Europe/Moscow.
# TZ задаёт окружение команд, но не гарантирует часовой пояс самого cron.
# Перед включением применить migrations/116_cron_load_control.sql.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
TZ=Europe/Moscow
HAULZ_CRON_API_BASE=http://127.0.0.1:3000

# Независимые очереди. Запросы к 1С сериализует общий ограничитель в БД.
# Текущие счета/перевозки: окно 3 дня, интервал в БД 20 минут.
*/5 * * * * /opt/haulz/cron-call.sh '/api/cron/refresh-cache?kind=perevozki&lane=recent'
1-59/5 * * * * /opt/haulz/cron-call.sh '/api/cron/refresh-cache?kind=invoices&lane=recent'
# Один день старых незакрытых документов за тик; у каждой очереди свой курсор.
2-59/5 * * * * /opt/haulz/cron-call.sh '/api/cron/refresh-cache?kind=perevozki&lane=active'
3-59/5 * * * * /opt/haulz/cron-call.sh '/api/cron/refresh-cache?kind=invoices&lane=active'
4-59/5 * * * * /opt/haulz/cron-call.sh '/api/cron/refresh-cache?kind=auxiliary'
0 2 * * * /opt/haulz/cron-call.sh /api/cron/refresh-cache-deep
30 3 * * * /opt/haulz/cron-call.sh /api/cron/backfill-sendings-metrics
0 * * * * /opt/haulz/cron-call.sh /api/cron/refresh-orders-cache
30 1 * * * /opt/haulz/cron-call.sh '/api/cron/refresh-orders-cache?mode=backfill'
0 3 * * * /opt/haulz/cron-call.sh /api/cron/refresh-suppliers-cache
7 * * * * /opt/haulz/cron-call.sh /api/cron/process-claim-push-queue
0 * * * * /opt/haulz/cron-call.sh /api/notification-poll
0 4 * * * /opt/haulz/cron-call.sh /api/cron/refresh-tariffs-cache
0 0 * * * /opt/haulz/cron-call.sh /api/cron/refresh-sverki-cache
0 5 * * * /opt/haulz/cron-call.sh /api/cron/refresh-dogovors-cache
0 6 * * * /opt/haulz/cron-call.sh /api/cron/refresh-pvz-cache
17 13 * * * /opt/haulz/cron-call.sh /api/notification-daily-summary
0 7 * * * /opt/haulz/cron-call.sh /api/cron/weekly-partner-summary
# Продолжает только уже начатую рассылку; не создаёт новую.
5,10,15,20,25,30,35,40,45,50,55 7 * * * /opt/haulz/cron-call.sh '/api/cron/weekly-partner-summary?continue=1'
20 * * * * /opt/haulz/cron-call.sh /api/cron/sync-pickup-numbers

# Ночной обход: один день за запуск, 18 дней за ночь на каждый тип.
8,28,48 0-5 * * * /opt/haulz/cron-call.sh '/api/cron/refresh-cache?kind=perevozki&lane=history'
9,29,49 0-5 * * * /opt/haulz/cron-call.sh '/api/cron/refresh-cache?kind=invoices&lane=history'
