[Unit]
Description=HAULZ Cron worker (Node, localhost only)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/haulz/app
EnvironmentFile=-/opt/haulz/.env
Environment=HAULZ_ENV_FILE=/opt/haulz/.env
Environment=PORT=3000
Environment=HOST=127.0.0.1
Environment=HAULZ_REQUEST_TIMEOUT_MS=300000
Environment=NODE_OPTIONS=--max-old-space-size=2048
ExecStart=/usr/bin/npm run api:start
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
LimitNOFILE=65535
OOMScoreAdjust=100

[Install]
WantedBy=multi-user.target
