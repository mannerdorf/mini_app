# Скопировать на VPS: sudo cp deploy/env.backend.example /opt/haulz/.env && sudo nano /opt/haulz/.env

# --- Postgres (Timeweb Cloud DBaaS или локальный VPS) ---
# Timeweb managed (SSL):
# DATABASE_URL=postgresql://USER:PASS@HOST:5432/DB?sslmode=require
# PGSSLMODE=require
#
# Локальный Postgres на VPS:
# DATABASE_URL=postgresql://haulz:PASSWORD@127.0.0.1:5432/haulz
# PGSSLMODE=disable
DATABASE_URL=
PGSSLMODE=require

# --- Публичные URL (без Vercel) ---
PUBLIC_API_ORIGIN=https://api.haulz.space
APP_URL=https://haulz.space
NEXT_PUBLIC_APP_URL=https://haulz.space

CRON_SECRET=
PEREVOZKI_SERVICE_LOGIN=
PEREVOZKI_SERVICE_PASSWORD=
# Загрузка заявки в 1С (POST JSON → GETAPI?metod=LoadZayavka по умолчанию):
# ONE_C_ZAYAVKA_UPLOAD_METOD=LoadZayavka
# ONE_C_ZAYAVKA_UPLOAD_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ADMIN_LOGIN=
ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=
SERVICE_MODE_PASSWORD=

# Реквизиты для QR (миграция 074 haulz_company_payee; если таблицы нет — дефолт из кода / env):
# HAULZ_PAYEE_ACCOUNT=40702810910001507546
# HAULZ_PAYEE_BIC=044525974
# HAULZ_PAYEE_BANK_NAME=АО «ТИНЬКОФФ БАНК»
# HAULZ_PAYEE_CORR_ACCOUNT=30101810145250000974
# ИНН заказчика 5 POST (через запятую). По умолчанию в коде: 7722461620.
FIVEPOST_CUSTOMER_INNS=7722461620

# Перевод названий 5 POST (приоритет Yandex — работает с VPS в РФ):
# 1) Сервисный аккаунт → роли на каталог: ai.translate.user, resource-manager.viewer
# 2) Создать API-ключ для этого аккаунта
# https://console.cloud.yandex.ru/folders/<folder>/translate
YANDEX_TRANSLATE_API_KEY=
YANDEX_FOLDER_ID=
